---
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"

// Set the arrival date explicitly
const arrivalDate = new Date("2025-04-17T07:00:00")

const title = "💝 Counting Down to Mui's Arrival 💝"
const description = "Every second brings me closer to you..."

// Format the date for display
const formattedDate = arrivalDate.toLocaleDateString("en-US", {
  weekday: "long",
  year: "numeric",
  month: "long",
  day: "numeric",
})
---

<PageLayout title={title} description={description}>
  <Container>
    <div class="space-y-16 py-10">
      <div class="animate text-center">
        <h1 class="text-3xl font-semibold text-black dark:text-white mb-4">
          {title}
        </h1>
        <div class="flex justify-center mb-4">
          <img
            src="/images/muis-arrival.png"
            alt="Floating hearts"
            class="rounded-lg w-auto h-512 object-cover"
          />
        </div>
        <p class="text-lg italic opacity-75">
          "In the arithmetic of love, one plus one equals everything, and two
          minus one equals nothing."
        </p>
      </div>

      <div class="animate flex justify-center">
        <div class="grid grid-cols-4 gap-4 text-center">
          <div class="countdown-box">
            <div
              id="days"
              class="text-4xl font-bold text-pink-600 dark:text-pink-400"
            >
              00
            </div>
            <div class="text-sm opacity-75">Days</div>
          </div>
          <div class="countdown-box">
            <div
              id="hours"
              class="text-4xl font-bold text-pink-600 dark:text-pink-400"
            >
              00
            </div>
            <div class="text-sm opacity-75">Hours</div>
          </div>
          <div class="countdown-box">
            <div
              id="minutes"
              class="text-4xl font-bold text-pink-600 dark:text-pink-400"
            >
              00
            </div>
            <div class="text-sm opacity-75">Minutes</div>
          </div>
          <div class="countdown-box">
            <div
              id="seconds"
              class="text-4xl font-bold text-pink-600 dark:text-pink-400"
            >
              00
            </div>
            <div class="text-sm opacity-75">Seconds</div>
          </div>
        </div>
      </div>

      <div class="hourglass mx-auto">
        <div class="top-sand"></div>
        <div class="bottom-sand"></div>
      </div>

      <div class="animate space-y-8 max-w-2xl mx-auto text-center">
        <div class="space-y-4">
          <h2 class="text-2xl font-semibold text-black dark:text-white">
            Dear Mui
          </h2>
          <p class="italic text-lg">
            With every passing moment, my heart beats a little faster,<br />
            Knowing soon I'll see your smile, feel your presence, share your laughter.<br
            />
            Two weeks may seem so long, yet love makes time take flight,<br />
            Until that precious moment when you're finally in my sight.
          </p>
        </div>

        <div class="flex justify-center my-8">
          <img
            src="https://media.giphy.com/media/26BRv0ThflsHCqDrG/giphy.gif"
            alt="Love birds"
            class="rounded-lg shadow-lg w-64"
          />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div
            class="love-note p-6 rounded-lg bg-pink-50 dark:bg-pink-900/20 transform hover:scale-105 transition-transform duration-300"
          >
            <div class="flex justify-center mb-4">
              <img
                src="https://media.giphy.com/media/7y4Nc95399hsr24oYc/giphy.gif?cid=790b7611rrn6imb5ou0btq84mg16ed3k10n6l7copzp8q081&ep=v1_gifs_search&rid=giphy.gif&ct=g"
                alt="Heart"
                class="w-12 h-12"
              />
            </div>
            <h3 class="font-semibold mb-2">What I Love About You</h3>
            <p>
              Your gentle soul, your radiant smile, the way you make everything
              worthwhile...
            </p>
          </div>
          <div
            class="love-note p-6 rounded-lg bg-pink-50 dark:bg-pink-900/20 transform hover:scale-105 transition-transform duration-300"
          >
            <div class="flex justify-center mb-4">
              <img
                src="https://media.giphy.com/media/c76IJLufpNwSULPk77/giphy.gif?cid=790b7611rrn6imb5ou0btq84mg16ed3k10n6l7copzp8q081&ep=v1_gifs_search&rid=giphy.gif&ct=g"
                alt="Love"
                class="w-12 h-12"
              />
            </div>
            <h3 class="font-semibold mb-2">Our Plans Together</h3>
            <p>
              Adventures await, memories to create, stories to tell, moments to
              celebrate...
            </p>
          </div>
        </div>

        <div class="mt-12 space-y-6">
          <h3 class="text-xl font-semibold text-pink-600 dark:text-pink-400">
            Moments We'll Share
          </h3>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div
              class="p-4 bg-white dark:bg-gray-800 rounded-lg shadow-lg transform hover:scale-105 transition-transform duration-300"
            >
              <img
                src="https://media.giphy.com/media/3o7TKoWXm3okO1kgHC/giphy.gif"
                alt="Sunset"
                class="w-full rounded-lg mb-2"
              />
              <p class="text-sm">Watching sunsets together</p>
            </div>
            <div
              class="p-4 bg-white dark:bg-gray-800 rounded-lg shadow-lg transform hover:scale-105 transition-transform duration-300"
            >
              <img
                src="https://media.giphy.com/media/Vn39qGcSPs3FKfVCCE/giphy.gif?cid=790b7611rxw3unp71ugp5s6kv753sbkmsj903on36e5qo3gx&ep=v1_gifs_search&rid=giphy.gif&ct=g"
                alt="Adventure"
                class="w-full rounded-lg mb-2 h-[165px] w-auto mx-auto"
              />
              <p class="text-sm">Going on adventures</p>
            </div>
            <div
              class="p-4 bg-white dark:bg-gray-800 rounded-lg shadow-lg transform hover:scale-105 transition-transform duration-300"
            >
              <img
                src="https://media.giphy.com/media/v1.Y2lkPTc5MGI3NjExcnJuNmltYjVvdTBidHE4NG1nMTZlZDNrMTBuNmw3Y29wenA4cTA4MSZlcD12MV9naWZzX3NlYXJjaCZjdD1n/l4Ki4biBSwhjyrS48/giphy.gif"
                alt="Love"
                class="w-full rounded-lg mb-2"
              />
              <p class="text-sm">Creating memories</p>
            </div>
          </div>
        </div>

        <div
          class="mt-12 p-6 bg-linear-to-r from-pink-100 to-purple-100 dark:from-pink-900/20 dark:to-purple-900/20 rounded-lg"
        >
          <h3 class="text-xl font-semibold mb-4">
            Our Love Story Continues...
          </h3>
          <p class="text-lg">
            Every moment apart makes our reunion sweeter,<br />
            Every second counted brings us closer together,<br />
            Until finally, in two weeks time,<br />
            Our hearts will beat as one again. ❤️
          </p>
        </div>
      </div>
    </div>
  </Container>

  <style>
    @reference "tailwindcss";
    .countdown-box {
      @apply p-4 rounded-lg bg-pink-50 dark:bg-pink-900/20 border border-pink-200 dark:border-pink-800 transform hover:scale-105 transition-transform duration-300;
    }

    .hourglass {
      width: 50px;
      height: 80px;
      position: relative;
      border: 2px solid currentColor;
      border-radius: 4px;
      animation: rotate 2s ease-in-out infinite;
    }

    .top-sand,
    .bottom-sand {
      position: absolute;
      left: 50%;
      width: 20px;
      height: 20px;
      background: var(--color-pink-400);
      border-radius: 50%;
      transform: translateX(-50%);
    }

    .top-sand {
      top: 10px;
      animation: drip 2s linear infinite;
    }

    .bottom-sand {
      bottom: 10px;
      animation: collect 2s linear infinite;
    }

    @keyframes rotate {
      0%,
      90% {
        transform: rotate(0deg);
      }
      100% {
        transform: rotate(180deg);
      }
    }

    @keyframes drip {
      0% {
        transform: translateX(-50%) scale(1);
        opacity: 1;
      }
      100% {
        transform: translateX(-50%) translateY(30px) scale(0);
        opacity: 0;
      }
    }

    @keyframes collect {
      0% {
        transform: translateX(-50%) scale(0);
        opacity: 0;
      }
      100% {
        transform: translateX(-50%) scale(1);
        opacity: 1;
      }
    }

    .love-note {
      position: relative;
      overflow: hidden;
    }

    .love-note::before {
      content: "";
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: linear-gradient(
        45deg,
        transparent,
        transparent 40%,
        rgba(255, 255, 255, 0.1) 50%,
        transparent 60%,
        transparent
      );
      transform: rotate(45deg);
      animation: shine 3s infinite;
    }

    @keyframes shine {
      0% {
        transform: translateX(-100%) rotate(45deg);
      }
      100% {
        transform: translateX(100%) rotate(45deg);
      }
    }
  </style>

  <script define:vars={{ arrivalDate: arrivalDate.getTime() }}>
    function updateCountdown() {
      const now = new Date().getTime()
      const distance = arrivalDate - now

      const days = Math.floor(distance / (1000 * 60 * 60 * 24))
      const hours = Math.floor(
        (distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
      )
      const minutes = Math.floor(
        (distance % (1000 * 60 * 60)) / (1000 * 60 * 60)
      )
      const seconds = Math.floor((distance % (1000 * 60)) / 1000)

      document.getElementById("days").textContent = String(days).padStart(
        2,
        "0"
      )
      document.getElementById("hours").textContent = String(hours).padStart(
        2,
        "0"
      )
      document.getElementById("minutes").textContent = String(minutes).padStart(
        2,
        "0"
      )
      document.getElementById("seconds").textContent = String(seconds).padStart(
        2,
        "0"
      )

      if (distance < 0) {
        clearInterval(countdownInterval)
        document.getElementById("days").textContent = "00"
        document.getElementById("hours").textContent = "00"
        document.getElementById("minutes").textContent = "00"
        document.getElementById("seconds").textContent = "00"
      }
    }

    const countdownInterval = setInterval(updateCountdown, 1000)
    updateCountdown()
  </script>
</PageLayout>
