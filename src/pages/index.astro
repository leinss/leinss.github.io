---
import ArrowCard from "@components/ArrowCard.astro"
import Container from "@components/Container.astro"
import Link from "@components/Link.astro"
import { APPS, HACKATHON_SLUGS, HOME, SITE, SOCIALS } from "@consts"
import PageLayout from "@layouts/PageLayout.astro"
import { dateRange } from "@lib/utils"
import { Image } from "astro:assets"
import { getCollection, render } from "astro:content"

const APP_SLUGS = APPS.map((app) => app.slug)

const projects = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .filter((project) => !HACKATHON_SLUGS.includes(project.id))
  .filter((project) => !APP_SLUGS.includes(project.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE)

const allwork = (await getCollection("work"))
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() -
      new Date(a.data.dateStart).valueOf()
  )
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE)

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await render(item)
    return { ...item, Content }
  })
)

const alleducation = (await getCollection("education"))
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() -
      new Date(a.data.dateStart).valueOf()
  )
  .slice(0, SITE.NUM_EDUCATION_ON_HOMEPAGE)

const education = await Promise.all(
  alleducation.map(async (item) => {
    const { Content } = await render(item)
    return { ...item, Content }
  })
)
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <h1 class="animate font-semibold text-2xl text-black dark:text-white">
      Hi <span class="text-2xl">👋🏻</span>, I'm Tobias Leinss.<br />
      <span class="text-black/70 dark:text-white/70 font-normal"
        >I build privacy-first apps you can install today.</span
      >
    </h1>
    <div class="space-y-16">
      <section class="animate space-y-4">
        <p>
          I design and ship small, focused apps that run on your own device.
          Most of them work fully offline; the AI features are optional and use
          a key you bring yourself. No accounts, no telemetry, no backend
          collecting your data.
        </p>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-xl text-black dark:text-white">
            📱 Apps I've built
          </h2>
          <Link href="/projects">⭐ See all projects</Link>
        </div>
        <ul class="animate-stagger grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            APPS.map((app) => (
              <li>
                <a
                  href={`/projects/${app.slug}`}
                  class="card-hover relative group flex flex-col h-full py-3 px-4 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
                >
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-semibold text-lg text-black dark:text-white">
                      {app.name}
                    </span>
                    <span class="text-xs text-nowrap px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/10 text-black/60 dark:text-white/60">
                      {app.platform}
                    </span>
                  </div>
                  <span class="text-sm text-black/60 dark:text-white/60 mt-1">
                    {app.tagline}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          👋 A little about me
        </h2>
        <Image
          class="animate rounded-md"
          src="/images/profile.jpg"
          alt="Tobias Leinss"
          width={280}
          height={406}
        />
        <p>
          I build custom-tailored software and the infrastructure behind it,
          end to end: AI integration and automation, mobile and desktop apps,
          web platforms, and the self-hosted infrastructure that runs them. I
          care about software that respects the people using it — local-first,
          transparent about what leaves the device, and pleasant to use.
        </p>
        <p>
          Before focusing on my own apps I spent years building Web3 and AI
          systems for companies and teams — smart contracts, backends, devops
          and AI integration. That background still shows up in the apps.
        </p>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          🤖 AI consulting
        </h2>
        <p>
          The apps above are proof I can take an idea and ship it end to end. If
          your company needs that same delivery for custom-tailored
          (<span lang="de">maßgeschneidert</span>) work — AI and automation,
          plus the self-hosted infrastructure behind it — I take that on through
          <a
            href="https://leinss-consulting.de"
            target="_blank"
            rel="noopener noreferrer">Leinss Consulting</a
          >: LLM assistants and chatbots, process automation, and the backends
          and devops to run them privately. If that's a fit, <a
            href="https://leinss-consulting.de"
            target="_blank"
            rel="noopener noreferrer">let's talk</a
          >.
        </p>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-xl text-black dark:text-white">
            Recent projects
          </h2>
          <Link href="/projects">⭐ See all projects</Link>
        </div>
        <ul class="animate-stagger flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-xl text-black dark:text-white">
            Work Experience
          </h2>
          <Link href="/work">🏢 See all work</Link>
        </div>
        <ul class="animate-stagger flex flex-col space-y-4">
          {
            work.map((entry) => (
              <li>
                <div class="text-sm opacity-75">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                </div>
                <div class="font-semibold text-black dark:text-white">
                  {entry.data.company}
                </div>
                <div class="text-sm opacity-75">{entry.data.role}</div>
                <article>
                  <entry.Content />
                </article>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-xl text-black dark:text-white">
            Education
          </h2>
          <Link href="/education">🎓 See all education</Link>
        </div>
        <ul class="animate-stagger flex flex-col space-y-4">
          {
            education.map((entry) => (
              <li>
                <div class="text-sm opacity-75">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd)}
                </div>
                <div class="font-semibold text-black dark:text-white">
                  {entry.data.place}
                </div>
                <div class="text-sm opacity-75">{entry.data.role}</div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          🤝 Let's connect
        </h2>
        <article>
          <p>
            Questions about an app, an invite to a beta, or a consulting
            project? Reach out by email or find me on the networks below.
          </p>
        </article>
        <ul class="flex flex-wrap gap-2 justify-center">
          {
            SOCIALS.map((SOCIAL) => (
              <li class="flex gap-x-2 text-nowrap">
                <Link
                  href={SOCIAL.HREF}
                  external
                  aria-label={`${SITE.NAME} on ${SOCIAL.NAME}`}
                  underline={false}
                >
                  <i
                    data-feather={SOCIAL.NAME}
                    class="w-5 h-5 mr-1.5 inline-block"
                  />
                  <span class="underline text-sm">{SOCIAL.NAME}</span>
                </Link>
                {"/"}
              </li>
            ))
          }
          <li class="line-clamp-1">
            <Link
              href={`mailto:${SITE.EMAIL}`}
              aria-label={`Email ${SITE.NAME}`}
              underline={false}
            >
              <i data-feather={"mail"} class="w-5 h-5 mr-1.5 inline-block"></i>
              <span class="underline text-sm">{SITE.EMAIL}</span>
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
