---
import PageLayout from "@layouts/PageLayout.astro"
import Container from "@components/Container.astro"

const BSKY_HANDLE = "leinss.bsky.social"
const BSKY_PROFILE_URL = `https://bsky.app/profile/${BSKY_HANDLE}`
---

<PageLayout
  title="Social"
  description="Latest posts from @leinss.bsky.social on Bluesky"
>
  <Container>
    <div class="space-y-10">
      <h1 class="animate font-semibold text-black dark:text-white">
        Social
      </h1>

      <div class="animate flex items-center gap-3 text-sm text-black/60 dark:text-white/60">
        <a
          href={BSKY_PROFILE_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 hover:text-black dark:hover:text-white transition-colors duration-300"
        >
          <svg class="w-4 h-4" viewBox="0 0 600 530" fill="currentColor" aria-hidden="true">
            <path d="M135.72 44.03C202.216 93.951 273.74 195.17 300 249.49c26.262-54.316 97.782-155.54 164.28-205.46C512.26 8.009 590-19.862 590 68.825c0 17.712-10.155 148.79-16.111 170.07-20.703 73.984-96.144 92.854-163.25 81.433 117.3 19.964 147.14 86.092 82.697 152.22-122.39 125.59-175.91-31.511-189.63-71.766-2.514-7.38-3.69-10.832-3.708-7.896-.017-2.936-1.193.516-3.707 7.896-13.714 40.255-67.233 197.36-189.63 71.766-64.444-66.128-34.605-132.26 82.697-152.22-67.108 11.421-142.55-7.45-163.25-81.433C20.15 217.615 10 86.535 10 68.823c0-88.687 77.742-60.816 125.72-24.795z"/>
          </svg>
          @{BSKY_HANDLE}
        </a>
      </div>

      <div id="bsky-feed" class="space-y-6 animate">
        <div id="bsky-loading" class="text-sm text-black/40 dark:text-white/40">
          Loading posts…
        </div>
      </div>
    </div>
  </Container>
</PageLayout>

<script is:inline define:vars={{ BSKY_HANDLE }}>
  async function loadFeed() {
    const feed = document.getElementById("bsky-feed")
    const loading = document.getElementById("bsky-loading")

    try {
      const res = await fetch(
        `https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=${encodeURIComponent(BSKY_HANDLE)}&limit=30&filter=posts_no_replies`
      )
      if (!res.ok) throw new Error(`HTTP ${res.status}`)
      const data = await res.json()

      const posts = (data.feed || []).filter(
        (item) => !item.reply && item.post?.record?.text
      )

      if (!posts.length) {
        loading.textContent = "No posts yet."
        return
      }

      loading.remove()

      for (const item of posts) {
        const post = item.post
        const record = post.record
        const rkey = post.uri.split("/").pop()
        const postUrl = `https://bsky.app/profile/${encodeURIComponent(BSKY_HANDLE)}/post/${encodeURIComponent(rkey)}`
        const dateStr = new Date(record.createdAt).toLocaleDateString("en", {
          year: "numeric", month: "short", day: "numeric",
        })

        const article = document.createElement("article")
        article.className = "group border-b border-black/5 dark:border-white/5 pb-6 last:border-0"

        // Post text, build with DOM nodes to handle facets safely
        const textEl = document.createElement("p")
        textEl.className = "text-sm leading-relaxed text-black/80 dark:text-white/80 whitespace-pre-wrap"
        buildRichText(textEl, record.text, record.facets)
        article.appendChild(textEl)

        // Embed: external link card
        const embed = post.embed
        if (embed?.$type === "app.bsky.embed.external#view" && embed.external) {
          const ext = embed.external
          try {
            const cardUrl = new URL(ext.uri)
            const card = document.createElement("a")
            card.href = cardUrl.href
            card.target = "_blank"
            card.rel = "noopener noreferrer"
            card.className = "block mt-3 rounded-lg border border-black/10 dark:border-white/10 overflow-hidden hover:border-black/30 dark:hover:border-white/30 transition-colors"
            if (ext.thumb) {
              const img = document.createElement("img")
              img.src = ext.thumb
              img.alt = ""
              img.className = "w-full h-32 object-cover"
              img.loading = "lazy"
              card.appendChild(img)
            }
            const cardBody = document.createElement("div")
            cardBody.className = "px-3 py-2"
            if (ext.title) {
              const title = document.createElement("div")
              title.className = "text-xs font-medium text-black dark:text-white truncate"
              title.textContent = ext.title
              cardBody.appendChild(title)
            }
            if (ext.description) {
              const desc = document.createElement("div")
              desc.className = "text-xs text-black/50 dark:text-white/50 mt-0.5 line-clamp-2"
              desc.textContent = ext.description
              cardBody.appendChild(desc)
            }
            const domain = document.createElement("div")
            domain.className = "text-xs text-black/30 dark:text-white/30 mt-1 truncate"
            domain.textContent = cardUrl.hostname
            cardBody.appendChild(domain)
            card.appendChild(cardBody)
            article.appendChild(card)
          } catch {
            // invalid URL, skip embed
          }
        }

        // Embed: images
        if (embed?.$type === "app.bsky.embed.images#view" && embed.images?.length) {
          const grid = document.createElement("div")
          grid.className = `mt-3 grid ${embed.images.length > 1 ? "grid-cols-2" : "grid-cols-1"} gap-1`
          for (const imgData of embed.images) {
            const img = document.createElement("img")
            img.src = imgData.thumb
            img.alt = imgData.alt || ""
            img.className = "rounded object-cover w-full"
            img.loading = "lazy"
            grid.appendChild(img)
          }
          article.appendChild(grid)
        }

        // Footer: date + stats + link
        const footer = document.createElement("div")
        footer.className = "flex items-center justify-between pt-1"
        const dateNode = document.createElement("span")
        dateNode.className = "text-xs text-black/30 dark:text-white/30"
        dateNode.textContent = dateStr
        footer.appendChild(dateNode)
        const stats = document.createElement("div")
        stats.className = "flex items-center gap-3 text-xs text-black/30 dark:text-white/30"
        if (post.likeCount) {
          const likes = document.createElement("span")
          likes.textContent = `♥ ${post.likeCount}`
          stats.appendChild(likes)
        }
        if (post.repostCount) {
          const reposts = document.createElement("span")
          reposts.textContent = `↺ ${post.repostCount}`
          stats.appendChild(reposts)
        }
        const viewLink = document.createElement("a")
        viewLink.href = postUrl
        viewLink.target = "_blank"
        viewLink.rel = "noopener noreferrer"
        viewLink.className = "opacity-0 group-hover:opacity-100 transition-opacity hover:text-black dark:hover:text-white"
        viewLink.textContent = "view →"
        stats.appendChild(viewLink)
        footer.appendChild(stats)
        article.appendChild(footer)

        feed.appendChild(article)
      }
    } catch (err) {
      if (loading) loading.textContent = `Could not load posts (${err.message})`
    }
  }

  // Build rich text node from AT Protocol facets without innerHTML
  function buildRichText(container, text, facets) {
    const enc = new TextEncoder()
    const dec = new TextDecoder()
    const bytes = enc.encode(text)

    const sorted = [...(facets || [])].sort(
      (a, b) => a.index.byteStart - b.index.byteStart
    )

    let cursor = 0
    for (const facet of sorted) {
      const { byteStart, byteEnd } = facet.index
      if (byteStart > cursor) {
        container.appendChild(
          document.createTextNode(dec.decode(bytes.slice(cursor, byteStart)))
        )
      }
      const segment = dec.decode(bytes.slice(byteStart, byteEnd))
      const feature = facet.features?.[0]
      if (feature?.$type === "app.bsky.richtext.facet#link") {
        try {
          const a = document.createElement("a")
          a.href = new URL(feature.uri).href
          a.target = "_blank"
          a.rel = "noopener noreferrer"
          a.className = "underline underline-offset-2 decoration-black/20 dark:decoration-white/20 hover:decoration-black/60 dark:hover:decoration-white/60 transition-colors"
          a.textContent = segment
          container.appendChild(a)
        } catch {
          container.appendChild(document.createTextNode(segment))
        }
      } else if (feature?.$type === "app.bsky.richtext.facet#mention") {
        const a = document.createElement("a")
        a.href = `https://bsky.app/profile/${encodeURIComponent(feature.did)}`
        a.target = "_blank"
        a.rel = "noopener noreferrer"
        a.className = "text-black/60 dark:text-white/60 hover:text-black dark:hover:text-white transition-colors"
        a.textContent = segment
        container.appendChild(a)
      } else {
        container.appendChild(document.createTextNode(segment))
      }
      cursor = byteEnd
    }

    if (cursor < bytes.length) {
      container.appendChild(
        document.createTextNode(dec.decode(bytes.slice(cursor)))
      )
    }
  }

  loadFeed()
</script>
