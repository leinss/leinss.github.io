---
import ArrowCard from "@components/ArrowCard.astro"
import Container from "@components/Container.astro"
import { HACKATHONS, HACKATHON_SLUGS } from "@consts"
import PageLayout from "@layouts/PageLayout.astro"
import { getCollection } from "astro:content"

const hackathons = (await getCollection("projects"))
  .filter((project) => !project.data.draft)
  .filter((project) => HACKATHON_SLUGS.includes(project.slug))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
---

<PageLayout title={HACKATHONS.TITLE} description={HACKATHONS.DESCRIPTION}>
  <Container>
    <div class="space-y-10">
      <div class="animate font-semibold text-black dark:text-white">
        🛠️ Hackathons
      </div>
      <ul class="animate flex flex-col gap-4">
        {
          hackathons.map((project) => (
            <li>
              <ArrowCard entry={project} />
            </li>
          ))
        }
      </ul>
    </div>
  </Container>
</PageLayout>
