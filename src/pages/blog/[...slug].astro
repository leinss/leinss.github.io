---
import { type CollectionEntry, getCollection, render } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";
import SocialShare from "@components/SocialShare.astro";
import BlogPostSchema from "@components/BlogPostSchema.astro";
import { buildTranslationIndex, type Lang, pairKey, postLang } from "@lib/blog";

export async function getStaticPaths() {
  const all = (await getCollection("blog")).filter(post => !post.data.draft);
  const posts = all.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  const index = buildTranslationIndex(all);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { ...post, translations: index.get(pairKey(post)) ?? {} },
  }));
}
type Props = CollectionEntry<"blog"> & {
  translations: Partial<Record<Lang, CollectionEntry<"blog">>>;
};

const post = Astro.props;
const { Content } = await render(post);
const postUrl = new URL(Astro.url.pathname, Astro.site).toString();
const lang = postLang(post);

// hreflang alternates: this post plus any translation in the other language.
const alternates = Object.entries(post.translations).map(([hreflang, entry]) => ({
  hreflang,
  href: new URL(`/blog/${entry.id}/`, Astro.site).toString(),
}));
---

<PageLayout title={post.data.title} description={post.data.description} image={post.data.image} lang={lang} alternates={alternates}>
  <BlogPostSchema
    title={post.data.title}
    description={post.data.description}
    date={post.data.date}
    image={post.data.image}
    url={postUrl}
  />
  <Container>
    <div class="animate">
      <BackToPrev href="/blog">
        Back to blog
      </BackToPrev>
    </div>
    <div class="space-y-1 my-10">
      <div class="animate flex items-center gap-1.5">
        <div class="font-base text-sm">
          <FormattedDate date={post.data.date} />
        </div>
        &bull;
        <div class="font-base text-sm">
          {readingTime(post.body ?? "")}
        </div>
      </div>
      <div class="animate text-2xl font-semibold text-black dark:text-white">
        {post.data.title}
      </div>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="animate flex flex-wrap gap-2 mt-2">
          {post.data.tags.map((tag: string) => (
            <span class="text-xs px-2 py-1 bg-black/5 dark:bg-white/10 rounded-sm">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
    <article class="animate">
      <Content />
    </article>
    <div class="animate">
      <SocialShare title={post.data.title} url={postUrl} />
    </div>
  </Container>
</PageLayout>