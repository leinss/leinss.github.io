---
import ArrowCard from "@components/ArrowCard.astro"
import Container from "@components/Container.astro"
import Link from "@components/Link.astro"
import { APPS, HACKATHON_SLUGS, HOME, SITE, SOCIALS } from "@consts"
import PageLayout from "@layouts/PageLayout.astro"
import { inLang, type Lang, localePath, pageAlternates, stripLang, t } from "@lib/i18n"
import { dateRange } from "@lib/utils"
import { Image } from "astro:assets"
// Imported rather than referenced from public/: Astro only optimises images it
// can resolve at build time. As a public path it shipped the 4060x5904, 3 MB
// original and let the browser scale it to 280px.
import profile from "@assets/profile.jpg"
import { getCollection, render } from "astro:content"

type Props = {
  lang: Lang
}

const { lang } = Astro.props

const APP_SLUGS = APPS.map((app) => app.slug)

const projects = inLang(await getCollection("projects"), lang)
  .filter((project) => !project.data.draft)
  .filter((project) => !HACKATHON_SLUGS.includes(stripLang(project.id)))
  .filter((project) => !APP_SLUGS.includes(stripLang(project.id)))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE)

const allwork = inLang(await getCollection("work"), lang)
  .sort(
    (a, b) =>
      new Date(b.data.dateStart).valueOf() -
      new Date(a.data.dateStart).valueOf()
  )
  .slice(0, SITE.NUM_WORKS_ON_HOMEPAGE)

const work = await Promise.all(
  allwork.map(async (item) => {
    const { Content } = await render(item)
    return { ...item, Content }
  })
)

const newestFirst = (a: { data: { dateStart: Date } }, b: { data: { dateStart: Date } }) =>
  new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf()

// Newest first would be the obvious order, but the degree is the oldest entry
// by six years, so the slice dropped it and the homepage listed three
// certificates and no degree. Degrees go first, then the rest by date.
const educationEntries = inLang(await getCollection("education"), lang)
const alleducation = [
  ...educationEntries.filter((entry) => entry.data.degree).sort(newestFirst),
  ...educationEntries.filter((entry) => !entry.data.degree).sort(newestFirst),
].slice(0, SITE.NUM_EDUCATION_ON_HOMEPAGE)

const education = await Promise.all(
  alleducation.map(async (item) => {
    const { Content } = await render(item)
    return { ...item, Content }
  })
)
---

<PageLayout
  title={HOME[lang].TITLE}
  description={HOME[lang].DESCRIPTION}
  lang={lang}
  alternates={pageAlternates("/", Astro.site)}
>
  <Container>
    {lang === "de" ? (
      <h1 class="animate font-semibold text-2xl text-black dark:text-white">
        Hallo <span class="text-2xl">👋🏻</span>, ich bin Tobias Leinss.<br />
        <span class="text-black/70 dark:text-white/70 font-normal"
          >Ich baue datenschutzfreundliche Apps, die Sie heute installieren können.</span
        >
      </h1>
    ) : (
      <h1 class="animate font-semibold text-2xl text-black dark:text-white">
        Hi <span class="text-2xl">👋🏻</span>, I'm Tobias Leinss.<br />
        <span class="text-black/70 dark:text-white/70 font-normal"
          >I build privacy-first apps you can install today.</span
        >
      </h1>
    )}
    <div class="space-y-16">
      <section class="animate space-y-4">
        {lang === "de" ? (
          <p>
            Ich entwerfe kleine, fokussierte Apps, die auf Ihrem eigenen Gerät
            laufen. Die meisten funktionieren komplett offline. Die KI-Funktionen
            sind optional und nutzen einen Schlüssel, den Sie selbst mitbringen.
            Kein Konto, keine Telemetrie, kein Server, der Ihre Daten sammelt.
          </p>
        ) : (
          <p>
            I design and ship small, focused apps that run on your own device.
            Most of them work fully offline; the AI features are optional and use
            a key you bring yourself. No accounts, no telemetry, no backend
            collecting your data.
          </p>
        )}
      </section>

      {/* No "See all projects" here. The grid below renders every entry in
          APPS, so the link led nowhere new, and the same link appears again on
          the Recent projects section further down. */}
      <section class="animate space-y-6">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          {t(lang, "appsHeading")}
        </h2>
        <ul class="animate-stagger grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            APPS.map((app) => (
              <li>
                <a
                  href={localePath(lang, `/projects/${app.slug}`)}
                  class="card-hover relative group flex flex-col h-full py-3 px-4 rounded-lg border border-black/15 dark:border-white/20 hover:bg-black/5 dark:hover:bg-white/5 hover:text-black dark:hover:text-white transition-colors duration-300 ease-in-out"
                >
                  <div class="flex items-center justify-between gap-2">
                    <span class="font-semibold text-lg text-black dark:text-white">
                      {app.name}
                    </span>
                    <span class="text-xs text-nowrap px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/10 text-black/60 dark:text-white/60">
                      {app.platform}
                    </span>
                  </div>
                  <span class="text-sm text-black/60 dark:text-white/60 mt-1">
                    {app.tagline[lang]}
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          {t(lang, "aboutHeading")}
        </h2>
        <Image
          class="animate rounded-md"
          src={profile}
          alt="Tobias Leinss"
          width={280}
          height={406}
          densities={[1, 2]}
          loading="lazy"
        />
        {lang === "de" ? (
          <>
            <p>
              Ich baue maßgeschneiderte Software und die Infrastruktur dahinter,
              von Anfang bis Ende: KI-Integration und Automatisierung, Apps für
              Smartphone und Desktop, Webplattformen und die selbst gehostete
              Infrastruktur, auf der sie laufen. Mir ist Software wichtig, die
              ihre Nutzer respektiert. Sie arbeitet lokal, sagt offen, was das
              Gerät verlässt, und ist angenehm zu bedienen.
            </p>
            <p>
              Bevor ich mich auf meine eigenen Apps konzentriert habe, habe ich
              jahrelang Web3- und KI-Systeme für Firmen und Teams gebaut: Smart
              Contracts, Backends, DevOps und KI-Integration. Diese Erfahrung
              steckt bis heute in den Apps.
            </p>
          </>
        ) : (
          <>
            <p>
              I build custom-tailored software and the infrastructure behind it,
              end to end: AI integration and automation, mobile and desktop apps,
              web platforms, and the self-hosted infrastructure that runs them. I
              care about software that respects the people using it: local-first,
              transparent about what leaves the device, and pleasant to use.
            </p>
            <p>
              Before focusing on my own apps I spent years building Web3 and AI
              systems for companies and teams: smart contracts, backends, devops
              and AI integration. That background still shows up in the apps.
            </p>
          </>
        )}
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          {t(lang, "consultingHeading")}
        </h2>
        {lang === "de" ? (
          <p>
            Die Apps oben zeigen, dass ich eine Idee von Anfang bis Ende umsetzen
            kann. Wenn Ihr Unternehmen genau das für maßgeschneiderte Arbeit
            braucht, also KI und Automatisierung samt der selbst gehosteten
            Infrastruktur dahinter, übernehme ich das über{" "}<a
              href="https://consulting.leinss.xyz/de/"
              target="_blank"
              rel="noopener noreferrer">Leinss Consulting</a
            >: KI-Assistenten und Chatbots, Prozessautomatisierung sowie
            Backends und DevOps, um alles privat zu betreiben. Wenn das
            passt, <a
              href="https://consulting.leinss.xyz/de/"
              target="_blank"
              rel="noopener noreferrer">sprechen wir darüber</a
            >.
          </p>
        ) : (
          <p>
            The apps above are proof I can take an idea and ship it end to end. If
            your company needs that same delivery for custom-tailored
            (<span lang="de">maßgeschneidert</span>) work: AI and automation,
            plus the self-hosted infrastructure behind it, I take that on through{
              " "
            }<a
              href="https://consulting.leinss.xyz"
              target="_blank"
              rel="noopener noreferrer">Leinss Consulting</a
            >: LLM assistants and chatbots, process automation, and the backends
            and devops to run them privately. If that's a fit, <a
              href="https://consulting.leinss.xyz"
              target="_blank"
              rel="noopener noreferrer">let's talk</a
            >.
          </p>
        )}
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-xl text-black dark:text-white">
            {t(lang, "recentProjects")}
          </h2>
          <Link href={localePath(lang, "/projects")}>{t(lang, "seeAllProjects")}</Link>
        </div>
        <ul class="animate-stagger flex flex-col gap-4">
          {
            projects.map((project) => (
              <li>
                <ArrowCard entry={project} />
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-xl text-black dark:text-white">
            {t(lang, "workHeading")}
          </h2>
          <Link href={localePath(lang, "/work")}>{t(lang, "seeAllWork")}</Link>
        </div>
        <ul class="animate-stagger flex flex-col divide-y divide-black/10 dark:divide-white/10">
          {
            work.map((entry) => (
              <li class="py-9 first:pt-0 last:pb-0">
                <div class="text-xs uppercase tracking-wider opacity-60">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd, lang)}
                </div>
                <div class="mt-1.5 font-semibold text-black dark:text-white">
                  {entry.data.company}
                </div>
                <div class="text-sm opacity-75">{entry.data.role}</div>
                <div class="entry-body mt-5">
                  <entry.Content />
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-6">
        <div class="flex flex-wrap gap-y-2 items-center justify-between">
          <h2 class="font-semibold text-xl text-black dark:text-white">
            {t(lang, "educationHeading")}
          </h2>
          <Link href={localePath(lang, "/education")}>{t(lang, "seeAllEducation")}</Link>
        </div>
        <ul class="animate-stagger flex flex-col space-y-5">
          {
            education.map((entry) => (
              <li>
                <div class="text-xs uppercase tracking-wider opacity-60">
                  {dateRange(entry.data.dateStart, entry.data.dateEnd, lang)}
                </div>
                <div class="mt-1.5 font-semibold text-black dark:text-white">
                  {entry.data.place}
                </div>
                <div class="text-sm opacity-75">{entry.data.role}</div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="animate space-y-4">
        <h2 class="font-semibold text-xl text-black dark:text-white">
          {t(lang, "connectHeading")}
        </h2>
        {lang === "de" ? (
          <p>
            Fragen zu einer App, eine Einladung zur Beta oder ein
            Beratungsprojekt? Schreiben Sie mir eine E-Mail oder finden Sie mich
            in den Netzwerken unten.
          </p>
        ) : (
          <p>
            Questions about an app, an invite to a beta, or a consulting project?
            Reach out by email or find me on the networks below.
          </p>
        )}
        <ul class="flex flex-wrap gap-2 justify-center">
          {
            SOCIALS.map((SOCIAL) => (
              <li class="flex gap-x-2 text-nowrap">
                <Link
                  href={SOCIAL.HREF}
                  external
                  aria-label={`${SITE.NAME} ${t(lang, "socialOn")} ${SOCIAL.LABEL ?? SOCIAL.NAME}`}
                  underline={false}
                >
                  <i
                    data-feather={SOCIAL.NAME}
                    class="w-5 h-5 mr-1.5 inline-block"
                  />
                  <span class="underline text-sm">
                    {SOCIAL.LABEL ?? SOCIAL.NAME}
                  </span>
                </Link>
                {"/"}
              </li>
            ))
          }
          <li class="line-clamp-1">
            <Link
              href={`mailto:${SITE.EMAIL}`}
              aria-label={`${t(lang, "emailTo")} ${SITE.NAME}`}
              underline={false}
            >
              <i data-feather={"mail"} class="w-5 h-5 mr-1.5 inline-block"></i>
              <span class="underline text-sm">{SITE.EMAIL}</span>
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</PageLayout>
