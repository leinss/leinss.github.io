---
import Container from "@components/Container.astro"
import Link from "@components/Link.astro"
import { SITE } from "@consts"
import { getCollection } from "astro:content"
import { entryLang, LEGAL_PAGES, type Lang, localePath, otherLang, stripLang, t } from "@lib/i18n"

type Props = {
  lang: Lang
  alternates?: { hreflang: string; href: string }[]
}

const { lang, alternates } = Astro.props

// The same page in the other language, or that language's home page where the
// page has no translation (an English-only blog post).
const switchLang = otherLang(lang)
const switchHref = (() => {
  const translation = alternates?.find((alt) => alt.hreflang === switchLang)
  return translation ? new URL(translation.href).pathname : localePath(switchLang, "/")
})()
const legalIds = Object.values(LEGAL_PAGES).flatMap((pages) => Object.values(pages))

const staticPages = (await getCollection("staticPages"))
  // Nav shows only top-level curated pages of this language. Nested pages (e.g.
  // projects/tobireader/privacy) are app docs linked from their project pages,
  // not site navigation.
  .filter((page) => !page.data.draft && entryLang(page.id) === lang)
  .filter((page) => !stripLang(page.id).includes("/") && !legalIds.includes(page.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between text-base">
      <Link href={localePath(lang, "/")} underline={false}>
        <div class="font-semibold">
          &lt;{SITE.NAME} /&gt;
        </div>
      </Link>
      {/* Wraps between entries, never inside one: the German label "was ich
          nutze" broke across three lines at phone width. */}
      <nav class="flex flex-wrap gap-x-1 text-base">
        {
          /* The separator belongs between the mapped links too. The hardcoded
             spans below only ever separated the fixed entries, so with two
             static pages the nav read "now uses / work / projects" and the
             first two ran together. Emitting it before every entry except the
             first keeps it correct for one page or five. */
          staticPages.map((page, i) => (
            <>
              {i > 0 && <span>{`/`}</span>}
              <Link href={`/${page.id}`} underline={false}>
                <span class="whitespace-nowrap">{page.data.title.toLocaleLowerCase()}</span>
              </Link>
            </>
          ))
        }
        <span>
          {`/`}
        </span>
        <Link href={localePath(lang, "/work")} underline={false}> {t(lang, "navWork")} </Link>
        <span>
          {`/`}
        </span>
        <Link href={localePath(lang, "/projects")} underline={false}> {t(lang, "navProjects")} </Link>
        <span>{`/`}</span>
        <Link
          href={switchHref}
          underline={false}
          hreflang={switchLang}
          lang={switchLang}
          aria-label={t(lang, "switchLabel")}
          title={t(lang, "switchLabel")}
        >
          {switchLang}
        </Link>
        <button
          data-theme-toggle
          aria-label={t(lang, "toggleTheme")}
          class="group flex items-center justify-center ml-3 hover:text-black dark:hover:text-white transition-colors duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </nav>
    </div>
  </Container>
</header>
