---
import Container from "@components/Container.astro"
import Link from "@components/Link.astro"
import { SITE } from "@consts"
import { getCollection } from "astro:content"

const staticPages = (await getCollection("staticPages"))
  .filter((page) => !page.data.draft && page.slug !== "/imprint" && page.slug !== "/privacy")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between text-base">
      <Link href="/" underline={false}>
        <div class="font-semibold">
          {SITE.NAME}
        </div>
      </Link>
      <nav class="flex gap-1 text-base">
        {
          staticPages.map((page) => (
            <Link href={page.slug} underline={false}>
              {page.data.title.toLocaleLowerCase()}
            </Link>
          ))
        }
        <span>
          {`/`}
        </span>
        <Link href="/work" underline={false}> work </Link>
        <span>
          {`/`}
        </span>
        <Link href="/projects" underline={false}> projects </Link>
        <span>
          {`/`}
        </span>
        <Link href="/hackathons" underline={false}> hackathons </Link>
      </nav>
    </div>
  </Container>
</header>
