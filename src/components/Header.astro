---
import Container from "@components/Container.astro"
import Link from "@components/Link.astro"
import { SITE } from "@consts"
import { getCollection } from "astro:content"

const staticPages = (await getCollection("staticPages"))
  .filter((page) => !page.data.draft && page.id !== "imprint" && page.id !== "privacy")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE)
---

<header>
  <Container>
    <div class="flex flex-wrap gap-y-2 justify-between text-base">
      <Link href="/" underline={false}>
        <div class="font-semibold">
          {SITE.NAME}
        </div>
      </Link>
      <nav class="flex gap-1 text-base">
        {
          staticPages.map((page) => (
            <Link href={`/${page.id}`} underline={false}>
              {page.data.title.toLocaleLowerCase()}
            </Link>
          ))
        }
        <span>
          {`/`}
        </span>
        <Link href="/work" underline={false}> work </Link>
        <span>
          {`/`}
        </span>
        <Link href="/projects" underline={false}> projects </Link>
        <span>
          {`/`}
        </span>
        <Link href="/social" underline={false}> social </Link>
        <span>{`/`}</span>
        <button
          data-theme-toggle
          aria-label="Toggle theme"
          class="group flex items-center justify-center hover:text-black dark:hover:text-white transition-colors duration-300"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden dark:block">
            <circle cx="12" cy="12" r="5"></circle>
            <line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line>
            <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line>
            <line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line>
            <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line>
          </svg>
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="block dark:hidden">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </button>
      </nav>
    </div>
  </Container>
</header>
