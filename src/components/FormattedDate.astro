---
import { type Lang, t } from "@lib/i18n";

interface Props {
  date: Date;
  lang?: Lang;
}

const { date, lang = "en" } = Astro.props;
---

<time datetime={date.toISOString()}>
  {
    date.toLocaleDateString(t(lang, "dateLocale"), {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  }
</time>
