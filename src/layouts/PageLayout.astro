---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import { SITE } from "@consts";
import type { Lang } from "@lib/i18n";

type Alternate = { hreflang: string; href: string };

type Props = {
  title: string;
  description: string;
  image?: string;
  lang?: Lang;
  alternates?: Alternate[];
};

const { title, description, image, lang = "en", alternates } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} image={image} alternates={alternates} lang={lang} />
  </head>
  <body>
    <Header lang={lang} alternates={alternates} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
